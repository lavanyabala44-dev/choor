rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedMember(id) {
      return id in [
        'narendra-modi',
        'rajnath-singh',
        'amit-shah',
        'nitin-gadkari',
        'nirmala-sitharaman',
        'shivraj-singh-chouhan',
        's-jaishankar',
        'j-p-nadda',
        'manohar-lal-khattar',
        'h-d-kumaraswamy',
        'piyush-goyal',
        'jitan-ram-manjhi',
        'lalan-singh',
        'sarbananda-sonowal',
        'virendra-kumar',
        'k-rammohan-naidu',
        'pralhad-joshi',
        'dharmendra-pradhan',
        'jual-oram',
        'giriraj-singh',
        'ashwini-vaishnaw',
        'jyotiraditya-scindia',
        'bhupender-yadav',
        'gajendra-singh-shekhawat',
        'annpurna-devi',
        'kiren-rijiju',
        'hardeep-singh-puri',
        'mansukh-mandaviya',
        'g-kishan-reddy',
        'chirag-paswan',
        'c-r-patil',
        'gyanesh-kumar-cec',
        'pema-khandu',
        'himanta-biswa-sarma',
        'samrat-choudhary',
        'vishnu-deo-sai',
        'pramod-sawant',
        'bhupendra-patel',
        'nayab-singh-saini',
        'mohan-yadav',
        'devendra-fadnavis',
        'yumnam-khemchand-singh',
        'mohan-charan-majhi',
        'bhajan-lal-sharma',
        'manik-saha',
        'yogi-adityanath',
        'pushkar-singh-dhami',
        'suvendu-adhikari',
        'n-chandrababu-naidu',
        'conrad-k-sangma',
        'neiphiu-rio',
        'prem-singh-tamang',
        'n-rangaswamy',
        'champat-rai',
        'anil-mishra',
        'subhash-srivastava',
        'tinnu-yadav',
        'avinash-shukla',
        'anukalp-mishra',
        'karunesh-pandey',
        'manish-kumar-yadav',
        'lavkush-mishra',
        'ram-shankar-mishra',
        'gopal-rao'
      ];
    }

    function validRecord(data) {
      return data.keys().hasAll(['chappal', 'juta', 'danda', 'laat'])
        && data.keys().hasOnly(['chappal', 'juta', 'danda', 'laat'])
        && data.chappal is int
        && data.juta is int
        && data.danda is int
        && data.laat is int
        && data.chappal >= 0
        && data.juta >= 0
        && data.danda >= 0
        && data.laat >= 0;
    }

    function validMessageStat(data) {
      return data.keys().hasAll(['memberId', 'weapon', 'message', 'date', 'count'])
        && data.keys().hasOnly(['memberId', 'weapon', 'message', 'date', 'count'])
        && allowedMember(data.memberId)
        && data.weapon in ['chappal', 'juta', 'danda', 'laat']
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 90
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.count is int
        && data.count >= 1;
    }

    function validLocationStat(data, statId) {
      return data.keys().hasAll(['countryCode', 'country', 'city', 'weapon', 'count'])
        && data.keys().hasOnly(['countryCode', 'country', 'city', 'weapon', 'count'])
        && data.countryCode is string
        && data.countryCode.matches('^[A-Z]{2}$')
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.city is string
        && data.city.size() > 0
        && data.city.size() <= 80
        && data.city.matches('^[^/]+$')
        && data.weapon in ['chappal', 'juta', 'danda', 'laat']
        && statId == data.countryCode + '|' + data.city + '|' + data.weapon
        && data.count is int
        && data.count >= 1;
    }

    function validPersonLocationStat(data, statId) {
      return data.keys().hasAll(['memberId', 'countryCode', 'country', 'city', 'weapon', 'count'])
        && data.keys().hasOnly(['memberId', 'countryCode', 'country', 'city', 'weapon', 'count'])
        && allowedMember(data.memberId)
        && data.countryCode is string
        && data.countryCode.matches('^[A-Z]{2}$')
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.city is string
        && data.city.size() > 0
        && data.city.size() <= 80
        && data.city.matches('^[^/|]+$')
        && data.weapon in ['chappal', 'juta', 'danda', 'laat']
        && statId == data.memberId + '|' + data.countryCode + '|' + data.city + '|' + data.weapon
        && data.count is int
        && data.count >= 1;
    }

    match /members/{memberId} {
      // The public page displays shared totals to every visitor.
      allow read: if true;

      // Clients may initialize known members at zero or record exactly one first hit.
      allow create: if allowedMember(memberId)
        && validRecord(request.resource.data)
        && (
          (request.resource.data.chappal == 0
            && request.resource.data.juta == 0
            && request.resource.data.danda == 0
            && request.resource.data.laat == 0)
          || request.resource.data.chappal
             + request.resource.data.juta
             + request.resource.data.danda
             + request.resource.data.laat == 1
        );

      // Each accepted write must increase exactly one weapon count by one.
      allow update: if allowedMember(memberId)
        && validRecord(resource.data)
        && validRecord(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['chappal', 'juta', 'danda', 'laat'])
        && (
          (request.resource.data.chappal == resource.data.chappal + 1
            && request.resource.data.juta == resource.data.juta
            && request.resource.data.danda == resource.data.danda
            && request.resource.data.laat == resource.data.laat)
          ||
          (request.resource.data.juta == resource.data.juta + 1
            && request.resource.data.chappal == resource.data.chappal
            && request.resource.data.danda == resource.data.danda
            && request.resource.data.laat == resource.data.laat)
          ||
          (request.resource.data.danda == resource.data.danda + 1
            && request.resource.data.chappal == resource.data.chappal
            && request.resource.data.juta == resource.data.juta
            && request.resource.data.laat == resource.data.laat)
          ||
          (request.resource.data.laat == resource.data.laat + 1
            && request.resource.data.chappal == resource.data.chappal
            && request.resource.data.juta == resource.data.juta
            && request.resource.data.danda == resource.data.danda)
        );

      // No one can delete a member's counts through the client.
      allow delete: if false;
    }

    // Daily per-person, per-weapon, per-message aggregates. Each accepted
    // client write can only create a count of one or increment by exactly one.
    match /messageStats/{statId} {
      allow read: if true;
      allow create: if validMessageStat(request.resource.data)
        && request.resource.data.count == 1;
      allow update: if validMessageStat(resource.data)
        && validMessageStat(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Country/city/weapon aggregates only; raw IP addresses are never stored.
    match /locationStats/{statId} {
      allow read: if true;
      allow create: if validLocationStat(request.resource.data, statId)
        && request.resource.data.count == 1;
      allow update: if validLocationStat(resource.data, statId)
        && validLocationStat(request.resource.data, statId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Per-person country/city/weapon aggregates; never store raw IP addresses.
    match /personLocationStats/{statId} {
      allow read: if true;
      allow create: if validPersonLocationStat(request.resource.data, statId)
        && request.resource.data.count == 1;
      allow update: if validPersonLocationStat(resource.data, statId)
        && validPersonLocationStat(request.resource.data, statId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // One shared, page-view counter. Public clients may only read it or
    // increase its count by exactly one; they cannot lower or delete it.
    match /siteStats/{statId} {
      allow read: if statId == 'visitors';
      allow create: if statId == 'visitors'
        && request.resource.data.keys().hasAll(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == 1;
      allow update: if statId == 'visitors'
        && resource.data.keys().hasAll(['count'])
        && resource.data.keys().hasOnly(['count'])
        && resource.data.count is int
        && resource.data.count >= 1
        && request.resource.data.keys().hasAll(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
      allow delete: if false;
    }

    // Poll responses use Firebase anonymous authentication, separate from all
    // game counters. Each anonymous account may create one private vote record.
    function validPollState(code) {
      return code in ['AP','AR','AS','BR','CT','GA','GJ','HR','HP','JH','KA','KL','MP','MH','MN','ML','MZ','NL','OD','PB','RJ','SK','TN','TS','TR','UP','UK','WB','AN','CH','DN','DL','JK','LA','LD','PY'];
    }

    function validPollChoice(state, party) {
      return party in ['aap','bsp','bjp','cpi-m','inc','npp','other','undecided']
        || (state == 'AP' && party in ['tdp','ysrcp','janasena'])
        || (state == 'AR' && party in ['ppa'])
        || (state == 'AS' && party in ['agp','aiudf'])
        || (state == 'BR' && party in ['jdu','rjd','ljprv','ham'])
        || (state == 'GA' && party in ['mgp'])
        || (state == 'GJ' && party in ['aap-guj'])
        || (state == 'HR' && party in ['jannayak'])
        || (state == 'JH' && party in ['jmm','ajsu'])
        || (state == 'KA' && party in ['jds'])
        || (state == 'KL' && party in ['cpi','iuml','kc-m'])
        || (state == 'MH' && party in ['ss','ss-ubt','ncp','ncp-sp'])
        || (state == 'MN' && party in ['npf'])
        || (state == 'ML' && party in ['udp','vpp'])
        || (state == 'MZ' && party in ['mnf','zpm'])
        || (state == 'NL' && party in ['ndpp','npf'])
        || (state == 'OD' && party in ['bjd'])
        || (state == 'PB' && party in ['sad'])
        || (state == 'SK' && party in ['skm','sdf','cap'])
        || (state == 'TN' && party in ['aiadmk','dmk','ntk'])
        || (state == 'TS' && party in ['brs','aimim'])
        || (state == 'TR' && party in ['tmp'])
        || (state == 'UP' && party in ['sp'])
        || (state == 'WB' && party in ['aitc','aifb'])
        || (state == 'DL' && party in ['aap-del'])
        || (state == 'JK' && party in ['nc','pdp'])
        || (state == 'PY' && party in ['ainrc']);
    }

    function validPollTally(data, state, party) {
      return data.keys().hasAll(['stateCode','stateName','partyId','partyName','count'])
        && data.keys().hasOnly(['stateCode','stateName','partyId','partyName','count'])
        && data.stateCode == state
        && validPollState(state)
        && data.partyId == party
        && validPollChoice(state, party)
        && data.stateName is string
        && data.stateName.size() > 0
        && data.stateName.size() <= 80
        && data.partyName is string
        && data.partyName.size() > 0
        && data.partyName.size() <= 120
        && data.count is int
        && data.count >= 1;
    }

    function linkedNewPollVote(state, party) {
      return request.auth != null
        && !exists(/databases/$(database)/documents/pollVotes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/pollVotes/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/pollVotes/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/pollVotes/$(request.auth.uid)).data.stateCode == state
        && getAfter(/databases/$(database)/documents/pollVotes/$(request.auth.uid)).data.partyId == party;
    }

    function validPollVote(data, voteId) {
      let tallyPath = /databases/$(database)/documents/pollCounts/$(data.stateCode + '__' + data.partyId);
      return request.auth != null
        && voteId == request.auth.uid
        && data.keys().hasAll(['uid','stateCode','stateName','partyId','partyName','pollId','createdAt'])
        && data.keys().hasOnly(['uid','stateCode','stateName','partyId','partyName','pollId','createdAt'])
        && data.uid == request.auth.uid
        && data.pollId == 'state-support-v1'
        && validPollState(data.stateCode)
        && validPollChoice(data.stateCode, data.partyId)
        && data.stateName is string
        && data.stateName.size() > 0
        && data.stateName.size() <= 80
        && data.partyName is string
        && data.partyName.size() > 0
        && data.partyName.size() <= 120
        && data.createdAt is timestamp
        && existsAfter(tallyPath)
        && getAfter(tallyPath).data.stateCode == data.stateCode
        && getAfter(tallyPath).data.partyId == data.partyId
        && ((exists(tallyPath) && getAfter(tallyPath).data.count == get(tallyPath).data.count + 1)
          || (!exists(tallyPath) && getAfter(tallyPath).data.count == 1));
    }

    match /pollVotes/{voteId} {
      allow get: if request.auth != null && voteId == request.auth.uid;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/pollVotes/$(voteId))
        && validPollVote(request.resource.data, voteId);
      allow update, delete: if false;
    }

    // Publicly readable aggregate tallies; updates must be paired atomically
    // with creation of that authenticated user's first vote record.
    match /pollCounts/{tallyId} {
      allow read: if true;
      allow create: if validPollTally(request.resource.data, request.resource.data.stateCode, request.resource.data.partyId)
        && tallyId == request.resource.data.stateCode + '__' + request.resource.data.partyId
        && request.resource.data.count == 1
        && linkedNewPollVote(request.resource.data.stateCode, request.resource.data.partyId);
      allow update: if validPollTally(resource.data, resource.data.stateCode, resource.data.partyId)
        && validPollTally(request.resource.data, resource.data.stateCode, resource.data.partyId)
        && tallyId == resource.data.stateCode + '__' + resource.data.partyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && linkedNewPollVote(resource.data.stateCode, resource.data.partyId);
      allow delete: if false;
    }

    // India-wide poll collections are separate from state tallies so each
    // anonymous browser profile may submit one national party response and
    // one PM preference without changing existing state-poll votes.
    function validCentralParty(party) {
      return party in ['aap','bsp','bjp','cpi-m','inc','npp','other','undecided','tdp','jdu','aitc','sp','dmk'];
    }
    function validCentralPm(candidate) {
      return candidate in ['modi','rahul-gandhi','kejriwal','mamata-banerjee','nitish-kumar','akhilesh-yadav','chandrababu-naidu','other-leader','no-preference'];
    }
    function validCentralTally(data, choiceId, choiceField, nameField, partyChoice) {
      return data.keys().hasAll([choiceField,nameField,'count'])
        && data.keys().hasOnly([choiceField,nameField,'count'])
        && data[choiceField] == choiceId
        && (partyChoice ? validCentralParty(choiceId) : validCentralPm(choiceId))
        && data[nameField] is string
        && data[nameField].size() > 0
        && data[nameField].size() <= 120
        && data.count is int
        && data.count >= 1;
    }
    function validCentralVote(data, voteId, choiceId, choiceField, nameField, pollId, partyChoice) {
      let tallyCollection = partyChoice ? 'centralPartyCounts' : 'centralPmCounts';
      let tallyPath = /databases/$(database)/documents/$(tallyCollection)/$(choiceId);
      return request.auth != null
        && voteId == request.auth.uid
        && data.keys().hasAll(['uid',choiceField,nameField,'pollId','createdAt'])
        && data.keys().hasOnly(['uid',choiceField,nameField,'pollId','createdAt'])
        && data.uid == request.auth.uid
        && data[choiceField] == choiceId
        && (partyChoice ? validCentralParty(choiceId) : validCentralPm(choiceId))
        && data[nameField] is string
        && data[nameField].size() > 0
        && data[nameField].size() <= 120
        && data.pollId == pollId
        && data.createdAt is timestamp
        && existsAfter(tallyPath)
        && getAfter(tallyPath).data[choiceField] == choiceId
        && ((exists(tallyPath) && getAfter(tallyPath).data.count == get(tallyPath).data.count + 1)
          || (!exists(tallyPath) && getAfter(tallyPath).data.count == 1));
    }
    function linkedCentralVote(voteCollection, choiceId, choiceField) {
      let votePath = /databases/$(database)/documents/$(voteCollection)/$(request.auth.uid);
      return request.auth != null
        && !exists(votePath)
        && existsAfter(votePath)
        && getAfter(votePath).data.uid == request.auth.uid
        && getAfter(votePath).data[choiceField] == choiceId;
    }

    match /centralPartyVotes/{voteId} {
      allow get: if request.auth != null && voteId == request.auth.uid;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/centralPartyVotes/$(voteId))
        && validCentralVote(request.resource.data, voteId, request.resource.data.partyId, 'partyId', 'partyName', 'central-party-v1', true);
      allow update, delete: if false;
    }
    match /centralPartyCounts/{partyId} {
      allow read: if true;
      allow create: if validCentralTally(request.resource.data, partyId, 'partyId', 'partyName', true)
        && request.resource.data.count == 1
        && linkedCentralVote('centralPartyVotes', partyId, 'partyId');
      allow update: if validCentralTally(resource.data, partyId, 'partyId', 'partyName', true)
        && validCentralTally(request.resource.data, partyId, 'partyId', 'partyName', true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && linkedCentralVote('centralPartyVotes', partyId, 'partyId');
      allow delete: if false;
    }
    match /centralPmVotes/{voteId} {
      allow get: if request.auth != null && voteId == request.auth.uid;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/centralPmVotes/$(voteId))
        && validCentralVote(request.resource.data, voteId, request.resource.data.candidateId, 'candidateId', 'candidateName', 'central-pm-v1', false);
      allow update, delete: if false;
    }
    match /centralPmCounts/{candidateId} {
      allow read: if true;
      allow create: if validCentralTally(request.resource.data, candidateId, 'candidateId', 'candidateName', false)
        && request.resource.data.count == 1
        && linkedCentralVote('centralPmVotes', candidateId, 'candidateId');
      allow update: if validCentralTally(resource.data, candidateId, 'candidateId', 'candidateName', false)
        && validCentralTally(request.resource.data, candidateId, 'candidateId', 'candidateName', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && linkedCentralVote('centralPmVotes', candidateId, 'candidateId');
      allow delete: if false;
    }
  }
}
